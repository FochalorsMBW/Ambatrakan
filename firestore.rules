rules_version = '2';

// Aturan keamanan Firestore untuk Ambatrakan.
//
// PENTING: Saat ini aplikasi BELUM memakai Firebase Authentication — login hanya
// "pilih nama + PIN" di sisi client, dan seluruh state (termasuk password) ada di
// satu dokumen. Selama itu belum diperbaiki, TIDAK ADA aturan yang benar-benar aman:
// aplikasi membutuhkan akses baca/tulis tanpa auth.
//
// File ini menyediakan dua level. Default di bawah = level minimal agar app tetap
// jalan TAPI mencegah penyalahgunaan paling parah. Untuk keamanan sungguhan,
// aktifkan Firebase Auth lebih dulu (lihat SECURITY.md) lalu pakai blok berkomentar.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Level minimal (tanpa Firebase Auth) ---
    // appData/state: boleh dibaca & ditulis (dibutuhkan client), tapi hanya dokumen ini.
    match /appData/state {
      allow read, write: if true;
    }

    // notifications: client hanya boleh MEMBUAT dan MEMBACA, tidak boleh mengubah/menghapus.
    match /notifications/{notifId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if false;
    }

    // Tolak semua path lain secara default.
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Level aman (SETELAH mengaktifkan Firebase Auth) ---
    // Hapus blok "Level minimal" di atas dan pakai ini:
    //
    // match /appData/state {
    //   allow read: if request.auth != null;
    //   allow write: if request.auth != null; // idealnya: batasi ke admin lewat custom claims
    // }
    // match /notifications/{notifId} {
    //   allow create: if request.auth != null;
    //   allow read: if request.auth != null
    //     && resource.data.targetTenantId == request.auth.token.tenantId;
    //   allow update, delete: if false;
    // }
    // match /{document=**} { allow read, write: if false; }
  }
}
